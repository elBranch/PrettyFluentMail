<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Sources are inherited from the user's global NuGet.Config so `dotnet nuget push -s <name>` and stored credentials
    keep working. Package source mapping makes restore use nuget.org only, which central package management requires
    when more than one source is configured (NU1507).
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
