<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PrettyFluentMail</PackageId>
    <Title>PrettyFluentMail</Title>
    <Description>Builds and sends HTML emails from MJML templates with Scriban variables, using MailKit for SMTP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Mjml.Net" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PrettyFluentMail.Tests" />
  </ItemGroup>

</Project>
